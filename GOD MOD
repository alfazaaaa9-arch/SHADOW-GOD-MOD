--[[ 🌑 SHADOW HUB - ULTRA FAST & LAG-FREE ]]--
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Safe Remote Finder
local function findConsumeRemote()
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if not systems then return nil end
	local actionsSystem = systems:FindFirstChild("ActionsSystem")
	if not actionsSystem then return nil end
	local network = actionsSystem:FindFirstChild("Network")
	if not network then return nil end
	return network:FindFirstChild("Consume")
end

local Consume = findConsumeRemote()
if not Consume then
	Consume = ReplicatedStorage:FindFirstChild("Consume", true)
end

local CONFIG = {
	EatsPerBatch = 5,      -- 렉 방지를 위한 안전한 배치 설정
	HealThreshold = 95,
	InstaHeal = true,
}

local SLOTS = {}
for i = 1, 36 do table.insert(SLOTS, i) end

local state = {
	enabled = false,
	totalEaten = 0,
	eatSpeed = 0,
	speedCounter = 0,
	slotIndex = 1,
	lastHealth = 100,
}

pcall(function()
	getgenv().ShadowHubState = state
end)

