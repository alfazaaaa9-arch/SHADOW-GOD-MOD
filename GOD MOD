local function resetEat()
	state.slotIndex = 1
	StatusIndicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
end

local function setupHealthMonitor(char)
	local hum = char:FindFirstChild("Humanoid")
	if hum then
		state.lastHealth = hum.Health
		HealthLabel.Text = "❤️ " .. math.floor(hum.Health)
		hum.HealthChanged:Connect(function(newHealth)
			HealthLabel.Text = "❤️ " .. math.floor(newHealth)
			if newHealth < state.lastHealth and CONFIG.InstaHeal and Consume then
				task.spawn(function()
					pcall(function()
						for i = 1, 3 do
							Consume:InvokeServer(i)
						end
					end)
				end)
			end
			state.lastHealth = newHealth
		end)
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	setupHealthMonitor(char)
end)

if LocalPlayer.Character then
	setupHealthMonitor(LocalPlayer.Character)
end

-- Speed Counter Updater
task.spawn(function()
	while true do
		task.wait(1)
		if state.enabled then
			state.eatSpeed = state.speedCounter
			SpeedLabel.Text = "⚡" .. state.eatSpeed .. "/s"
			state.speedCounter = 0
		end
	end
end)

-- 렉 및 위치 어긋남 없는 비동기 루프
local function startEatingLoop()
	task.spawn(function()
		while state.enabled do
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChild("Humanoid")
			if not hum or hum.Health <= 0 then
				resetEat()
				task.wait(0.5)
			else
				for i = 1, CONFIG.EatsPerBatch do
					if not state.enabled then break end
					local slot = SLOTS[state.slotIndex]
					pcall(function()
						Consume:InvokeServer(slot)
						state.totalEaten = state.totalEaten + 1
						state.speedCounter = state.speedCounter + 1
					end)
					state.slotIndex = state.slotIndex + 1
					if state.slotIndex > #SLOTS then
						state.slotIndex = 1
					end
				end
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

local function toggleImmortal()
	state.enabled = not state.enabled
	if state.enabled then
		ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 10, 40)
		ToggleButton.Text = "ON"
		UIStroke.Color = Color3.fromRGB(0, 255, 0)
		StatusIndicator.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		startEatingLoop()
		print("🌑 SHADOW HUB: ON (Ultra Fast & Lag-Free)")
	else
		ToggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
		ToggleButton.Text = "OFF"
		UIStroke.Color = Color3.fromRGB(138, 43, 226)
		StatusIndicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		SpeedLabel.Text = "⚡0/s"
		print("🌑 SHADOW HUB: OFF")
	end
end

ToggleButton.MouseButton1Click:Connect(toggleImmortal)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.K then
		toggleImmortal()
	end
end)

